{
  "name": "narrative-anchor",
  "version": "0.8.0",
  "description": "DSH-Tavern 叙事锚定系统：大纲路线 + 多级记忆 + 当前状态，接入官方后台结算（plugin-api v2，零补丁）",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-sidebar"
      ]
    }
  }
}
